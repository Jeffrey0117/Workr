{
  "repo": 1,
  "name": "workr",
  "what": "Universal job queue platform for background tasks",
  "kind": "service",
  "work": {
    "guide": "CLAUDE.md",
    "run": "npm run dev",
    "deploy": "git push"
  },
  "offers": [
    {
      "id": "list_jobs",
      "what": "List jobs with optional filters",
      "how": "http",
      "http": {
        "method": "GET",
        "path": "/api/jobs",
        "auth": "bearer",
        "params": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "description": "Filter by status (queued/running/completed/failed)"
            },
            "type": {
              "type": "string",
              "description": "Filter by job type (thumbnail/webp/hls/download/proxy/deploy)"
            },
            "limit": {
              "type": "number",
              "description": "Max results to return"
            }
          }
        }
      }
    },
    {
      "id": "get_job",
      "what": "Get job status and details",
      "how": "http",
      "http": {
        "method": "GET",
        "path": "/api/jobs/{id}",
        "auth": "bearer",
        "params": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Job ID"
            }
          },
          "required": [
            "id"
          ]
        }
      }
    },
    {
      "id": "submit_job",
      "what": "Submit a new job (thumbnail/webp/hls/download/proxy/deploy)",
      "how": "http",
      "http": {
        "method": "POST",
        "path": "/api/jobs",
        "auth": "bearer",
        "params": {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "description": "Job type: thumbnail, webp, hls, download, proxy, deploy"
            },
            "payload": {
              "type": "object",
              "description": "Job-specific payload data"
            },
            "priority": {
              "type": "number",
              "description": "Job priority (higher = sooner)"
            },
            "callback": {
              "type": "string",
              "description": "Callback URL for completion notification"
            },
            "maxRetries": {
              "type": "number",
              "description": "Max retry attempts on failure"
            }
          },
          "required": [
            "type",
            "payload"
          ]
        }
      }
    },
    {
      "id": "cancel_job",
      "what": "Cancel a queued job",
      "how": "http",
      "http": {
        "method": "DELETE",
        "path": "/api/jobs/{id}",
        "auth": "bearer",
        "params": {
          "type": "object",
          "properties": {
            "id": {
              "type": "string",
              "description": "Job ID"
            }
          },
          "required": [
            "id"
          ]
        }
      }
    },
    {
      "id": "get_stats",
      "what": "Get queue statistics (queued, running, completed, failed counts)",
      "how": "http",
      "http": {
        "method": "GET",
        "path": "/api/stats"
      }
    },
    {
      "id": "proxy_request",
      "what": "HTTP proxy - forward request to target URL",
      "how": "http",
      "http": {
        "method": "GET",
        "path": "/proxy",
        "auth": "bearer",
        "params": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string",
              "description": "Target URL to proxy"
            }
          },
          "required": [
            "url"
          ]
        }
      }
    }
  ]
}
